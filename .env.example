# ===== GitHub OAuth App 配置（必填）=====
# 从 https://github.com/settings/developers → OAuth Apps 获取
GITSTARS_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ===== Docker 镜像（scripts/build-image.sh / compose.yaml 使用）=====
# 镜像仓库名；要推送请改成带仓库前缀的名字
GITSTARS_IMAGE_REPO=gitstars
# 运行哪个版本，需与 VERSION 文件 / 构建时的版本一致
GITSTARS_IMAGE_TAG=0.0.1

# ===== 仅 Docker 使用 =====
# 映射到宿主机的端口（容器内部固定监听 8080）
GITSTARS_PORT=8080
# 本地 HTTPS 证书目录（mkcert 生成，compose.tls.yaml 使用）
GITSTARS_CERT_DIR=./.certs

# ===== 可选 =====
# 缓存目录
# GITSTARS_DATA_DIR=./data
# 缓存有效期（秒）
# GITSTARS_STARS_TTL_SECS=900
# GITSTARS_RANKING_TTL_SECS=86400
# 日志级别
# RUST_LOG=info